{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host:localhost;Database:desksync_db;Username=myusername;Password=mypassword"
  },

  "AllowedHosts": "*",

  "WorkerSettings": {
    "DefaultBatchSize": 500
  },

  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "your-smtp-username",
    "Password": "your-smtp-password",
    "FromAddress": "noreply@desksync.com"
  }
}