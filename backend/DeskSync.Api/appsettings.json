{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host:localhost;Database:desksync_db;Username=myusername;Password=mypassword"
  },

  "AllowedHosts": "*",

  "WorkerSettings": {
    "DefaultBatchSize": 500,
    "ReminderWindowMinutes": 15,
    "NotificationRetentionDays": 30
  },

  "Smtp": {
    "Port": 587,
    "FromAddress": "desksync.community@gmail.com",
    "AppBaseUrl": "https://app.desksync.com"
  }
}